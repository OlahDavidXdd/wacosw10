diff --git a/src/comum/previsao.h b/src/comum/previsao.h
new file mode 100644
index 0000000..5ba1dec
--- /dev/null
+++ b/src/comum/previsao.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <string>
+
+namespace previsao {
+
+// ECMWF IFS is the primary forecast model. Keep Open-Meteo's local model
+// selection available when IFS is delayed or lacks the requested fields.
+template<class Get, class Accept>
+std::string Fetch(const std::wstring& path, Get get, Accept accept) {
+    const wchar_t* host = L"api.open-meteo.com";
+    auto body = get(host, path + L"&models=ecmwf_ifs");
+    if (accept(body)) return body;
+    body = get(host, path);
+    return accept(body) ? body : std::string{};
+}
+
+}  // namespace previsao
